<resources>
    <string name="app_name" translatable="false">财小通</string>
    <string name="settings_title">Settings</string>
    <string name="about_developer_name" translatable="false">Mercury</string>
    <string name="about_developer_id" translatable="false">Mercury000</string>
    <color name="splash_background">#FFFFFF</color>
    <style name="Theme.YktWx" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F7F7F7</item>
    </style>
    <style name="Theme.YktWx.Splash" parent="Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.YktWx</item>
    </style>
    <style name="Theme.UnionPay" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:dialogTheme">@android:style/Theme.Dialog</item>
    </style>
    <style name="Theme.UnionPayBridge" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="Theme.AlipayBridge" parent="Theme.UnionPayBridge" />
    <style name="Theme.Scanner" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:colorAccent">#7CE2B0</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
